{
  "name": "footfive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FootFive / Proball Manager — mobile cyborg football mini-manager",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src shared",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:e2e": "bash scripts/e2e-run.sh",
    "test:e2e:all": "E2E_ALL=1 bash scripts/e2e-run.sh",
    "test:e2e:api": "node tests/integration/e2e-api.mjs",
    "test:scoreboard": "node tests/integration/public-scoreboard.mjs",
    "test:bootstrap": "node tests/integration/bootstrap-clean.mjs",
    "test:security": "vitest run src/domain/security.test.ts",
    "test:account-security": "node tests/integration/account-security.mjs",
    "test:settlement": "node tests/integration/settlement-recovery.mjs",
    "test:progression": "node tests/integration/progression-lock.mjs",
    "test:recovery": "node scripts/restart-recovery.mjs",
    "rehearsal": "bash scripts/rehearsal.sh",
    "pb:serve": "cd pocketbase && ./pocketbase serve --http=127.0.0.1:8090",
    "setup:local": "bash scripts/setup-local.sh",
    "backup:local": "bash scripts/backup-local.sh",
    "deploy:check": "npm run test && npm run typecheck && npm run build",
    "perf:sample": "node scripts/perf-sample.mjs",
    "pw:libs": "bash scripts/ensure-playwright-libs.sh"
  },
  "dependencies": {
    "pocketbase": "^0.26.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^24.1.3",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
